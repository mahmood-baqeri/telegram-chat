{
  "name": "messenger-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade messaging platform backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testMatch='**/integration/**/*.test.js'",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/migrate.js --rollback",
    "seed": "node scripts/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.0",
    "redis": "^4.6.10",
    "bull": "^4.11.5",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.1.4",
    "compression": "^1.7.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "fluent-ffmpeg": "^2.1.2",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "@elastic/elasticsearch": "^8.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "firebase-admin": "^11.11.0",
    "web-push": "^3.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "faker": "^5.5.3"
  }
}